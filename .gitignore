# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local reference checkout used only to regenerate embedded PM7 data.
.mopac-source/

# Local MOPAC oracle executable and generated oracle outputs.
tools/oracle/mopac-23.2.5-win/
tools/oracle/mopac-23.2.5-win.zip
tools/oracle/cases/*.aux
tools/oracle/cases/*.out
# Oracle validation working directories (regenerated by the tools/oracle/*.py scripts).
tools/oracle/dcases/
tools/oracle/hbcases/
tools/oracle/hbcases_m/
tools/oracle/scfres/
tools/oracle/pairsweep/
tools/oracle/fieldcases/
tools/oracle/ircases/
tools/oracle/lrcases/
# `tools/oracle/baselines/` is deliberately NOT ignored: the recorded threshold baselines are
# what every later run is compared against, so they belong in the repository.

# Python extension artifacts (maturin builds these locally into python/pm7_rs/).
**/__pycache__/
*.pyc
*.pyd
*.so

# Scaling / benchmark run artifacts (regenerated by tools/bench/*.py).
tools/bench/runs/
dist/

# Plots and the solved-band caches written by `examples/zncn2_phonon_bands.py`. The cache is what
# makes a re-plot cheap, so it is written next to the figure rather than into a temporary
# directory — but it is a derived file and belongs to whoever ran the script, not to the tree.
zncn2_phonons*.png
zncn2_phonons*.npz

# Release archives built by tools/make_release_zip.py. `Cargo.toml` already excludes `*.zip`
# from the published crate; this keeps them out of the repository as well.
*.zip

# Agent worktrees: separate checkouts of this same repository, not content of it.
.claude/worktrees/
